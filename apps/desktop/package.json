{
  "name": "@devbrain/desktop",
  "productName": "DevBrain AI",
  "version": "0.1.0",
  "private": true,
  "description": "DevBrain AI desktop application (Electron).",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "pnpm build && electron-builder --win nsis:x64 --publish never",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@devbrain/contracts": "workspace:*",
    "@devbrain/core": "workspace:*",
    "@devbrain/database": "workspace:*",
    "@devbrain/execution-engine": "workspace:*",
    "@devbrain/git-engine": "workspace:*",
    "@devbrain/project-engine": "workspace:*",
    "@devbrain/provider-sdk": "workspace:*",
    "@devbrain/security": "workspace:*",
    "@devbrain/ui": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.70.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.11.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  }
}
